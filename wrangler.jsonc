{
  "$schema": "node_modules/wrangler/config-schema.json",
  // TODO: rename to match your site, e.g. "web-myclientsite"
  "name": "web-SITENAME",
  "compatibility_date": "2026-05-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
