# Optional: sudo password for install-deps.sh when running as non-root.
# Copy this to .env (git-ignored) and fill in your password.
# If omitted, install-deps.sh downloads Chrome libs locally instead.
SUDO_PASS=

# Optional: Google PageSpeed Insights API key, used by pagespeed.mjs.
# Get one free at https://developers.google.com/speed/docs/insights/v5/get-started
# If omitted, requests use Google's shared unauthenticated quota (very low, easily exhausted).
PAGESPEED_API_KEY=
